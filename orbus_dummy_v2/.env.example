# OrbusSim Dummy V2 - Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Workspace root path (required if EXTERNAL_WORKSPACE_PATH is not set)
WORKSPACE_ROOT=/path/to/workspace

# External workspace path (alternative to WORKSPACE_ROOT)
EXTERNAL_WORKSPACE_PATH=/alternative/path/to/workspace

# Queue polling interval in seconds
QUEUE_POLL_INTERVAL_S=1.0

# Station pause duration in seconds
STATION_PAUSE_S=0.5

# Measurement interval in milliseconds
MEASUREMENT_INTERVAL_MS=100

# Fluorescence measurement duration in seconds
FLUORESCENCE_DURATION_S=5.0

# Temperature noise standard deviation in Celsius
TEMP_NOISE_STD_C=0.1

# Fluorescence noise standard deviation in arbitrary units
FLUORESCENCE_NOISE_STD_AU=0.01

# Dosing noise percentage
DOSING_NOISE_PERCENT=1.0

# Optional simulation seed for reproducibility
SIMULATION_SEED=42
